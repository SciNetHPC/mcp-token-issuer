# token-issuer configuration
# Copy to .env for local runs. Production values come from a secret manager.

PORT=5000
SESSION_SECRET=change-me
OIDC_ISSUER_URL=https://idp.example.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/auth/callback
TOKEN_HMAC_SECRET=change-me-too
TOKEN_STORE_PATH=./token-store.json
TOKEN_TTL_DAYS=30
TOKEN_MAX_TTL_DAYS=365

# SERVICES is a JSON array of
# {id, name, description, descriptionFr?, url, slurmCluster?}.
# When unset, the built-in list describes SciNet's production services.
# Override it with your own services. Entries may carry an optional
# "descriptionFr" string for the French UI.
# LDAP is only needed for entries with a "slurmCluster" marker.

# Directory checks for cluster-gated services. LDAP is optional; leave
# LDAP_URL empty to run without cluster gating.
# LDAP_URL=ldaps://ldap.example.org
# LDAP_BASE_DN=dc=example,dc=org
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_CA_CERTS=
# LDAP_TLS_SERVERNAME=
# LDAP_TIMEOUT_MS=3000
# LDAP_CACHE_TTL_MS=300000
# BALAM_GROUP_CN=lcl_balam

# Account-disable checks (the directory has no webhook).
# ACCOUNT_DISABLE_SWEEP_SECONDS=60
# ACCOUNT_DISABLE_SWEEP_CONCURRENCY=4

# Admin access: OIDC groups (default "scinet") and/or an ops-maintained list.
# ADMIN_GROUPS=scinet
# ADMIN_LIST_PATH=/data/admin-users.json
